# MongoDB Connection (Use your MongoDB Atlas URI in production on Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/teacher-world?retryWrites=true&w=majority

# JWT Secrets for Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_random
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Gmail Configuration for OTP verification emails
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_16_char_app_password

# Brevo Configuration for Transactional Email API (Alternative/Primary provider)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=TeacherWorld

# Google Gemini AI API Key for Chatbot (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=https://teacher-world.vercel.app,http://localhost:5173

# OTP Settings
OTP_EXPIRY=600000

# Optional: Zoom Integration
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URL=https://teacher-world.onrender.com/zoom/callback
ZOOM_ACCOUNT_ID=your_zoom_account_id
