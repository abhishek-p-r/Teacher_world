# Teacher World Frontend - Example Environment Variables
# In production on Vercel: set VITE_API_URL to https://teacher-world.onrender.com/api
# In local development: set VITE_API_URL to http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
